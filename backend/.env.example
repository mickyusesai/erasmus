# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# Admin Authentication
ADMIN_PASSWORD=changeme_in_production

# File Storage
# Options: 'local' (development) or 'r2' (production with Cloudflare R2)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# Cloudflare R2 Configuration (required when STORAGE_TYPE=r2)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_bucket_name
# R2_JURISDICTION=eu (optional, set to "eu" for EU jurisdiction buckets)
# R2_PUBLIC_URL=https://your-custom-domain.com (optional, for public file access)

# Email Configuration
EMAIL_PROVIDER=console
# For production, use postmark:
# EMAIL_PROVIDER=postmark
# POSTMARK_SERVER_TOKEN=your_postmark_server_api_token
# EMAIL_FROM=micky@easyreimburse.ai

# Frontend URL (for magic links)
FRONTEND_URL=http://localhost:5173

# Session Secret
SESSION_SECRET=your_session_secret_here_change_in_production

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRODUCT_ID_SINGLE=prod_...
STRIPE_PRODUCT_ID_PACK_5=prod_...
STRIPE_PRODUCT_ID_PACK_10=prod_...
