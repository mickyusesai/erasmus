# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# Admin Authentication
ADMIN_PASSWORD=changeme_in_production

# File Storage
# Options: 'local' (development) or 'r2' (production with Cloudflare R2)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# Cloudflare R2 Configuration (required when STORAGE_TYPE=r2)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_bucket_name
# R2_JURISDICTION=eu (optional, set to "eu" for EU jurisdiction buckets)
# R2_PUBLIC_URL=https://your-custom-domain.com (optional, for public file access)

# Email Configuration
EMAIL_PROVIDER=console
# For production, use smtp or a service like SendGrid:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_password
# EMAIL_FROM=noreply@example.com

# Frontend URL (for magic links)
FRONTEND_URL=http://localhost:5173

# Session Secret
SESSION_SECRET=your_session_secret_here_change_in_production
