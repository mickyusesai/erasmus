  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": "^20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "prisma db push && node dist/index.js",
    "test": "vitest run",
