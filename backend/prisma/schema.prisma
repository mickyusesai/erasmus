generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// AUTHENTICATION & ORGANIZATION
// =============================================================================

// Organisation - the paying customer (one account per organisation)
model Organisation {
  id                      String    @id @default(uuid())
  name                    String
  email                   String    @unique  // Login email
  passwordHash            String
  oid                     String?   // Organisation ID (OID) - optional identifier

  // Credit tracking
  projectCredits          Int       @default(0)

  // Annual license
  hasAnnualLicense        Boolean   @default(false)
  annualLicenseStartedAt  DateTime?
  annualLicenseExpiresAt  DateTime?

  // Account status
  isActive                Boolean   @default(true)

  // Metadata
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  projects                Project[]
  purchases               Purchase[]
}

// Purchase history for audit trail and Stripe integration
model Purchase {
  id                String         @id @default(uuid())
  organisationId    String
  organisation      Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  type              PurchaseType
  amountCents       Int            // Amount in cents (e.g., 9500 = €95)
  currency          String         @default("EUR")
  creditsGranted    Int            // Number of credits added (0 for annual license)

  // Stripe integration
  stripeSessionId   String?        @unique
  stripePaymentIntentId String?
  stripeInvoiceUrl  String?

  status            PurchaseStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  completedAt       DateTime?

  @@index([organisationId])
  @@index([stripeSessionId])
}

enum PurchaseType {
  SINGLE      // €95, 1 credit
  PACK_5      // €395, 5 credits
  PACK_10     // €595, 10 credits
  ANNUAL      // €995, unlimited for 1 year
  FOUNDING    // Legacy: was for invitation-only free credit (no longer used)
  MANUAL      // Manually added by super admin
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Super Admin - internal administrative access
model SuperAdmin {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// =============================================================================
// PROJECT & PARTICIPANTS
// =============================================================================

// Project - an Erasmus+ youth project
model Project {
  id                       String                  @id @default(uuid())
  organisationId           String
  organisation             Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name                     String
  description              String?
  country                  String
  startDate                DateTime
  endDate                  DateTime
  disseminationEnabled     Boolean                 @default(false)  // Whether dissemination page is shown to participants
  carRatePerKm             Float                   @default(0.22)   // Rate per km for car travel reimbursement (EUR)
  venueAddress             String?                                  // Address of the project venue (helps AI understand travel destination)

  // Test project - automatically created for new organisations (max 10 participants)
  isTestProject            Boolean                 @default(false)
  maxParticipants          Int?                    // Null = unlimited, set to 10 for test projects

  // Credit tracking - which credit was used to create this project
  creditSource             PurchaseType?           // SINGLE, PACK_5, PACK_10, ANNUAL, FOUNDING, MANUAL, or null for test projects

  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  countryLimits            ProjectCountryLimit[]
  participants             Participant[]
  disseminationActivities  DisseminationActivity[]
}

// Maximum reimbursement amounts per sending country for a project
model ProjectCountryLimit {
  id                     String  @id @default(uuid())
  projectId              String
  project                Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  country                String
  maxReimbursementAmount Float
  currency               String  @default("EUR")
  greenTravel            Boolean @default(false) // If true, participants from this country use green travel (allows hotel uploads)

  @@unique([projectId, country])
}

// Participant - a young person who traveled to the project
model Participant {
  id                        String                  @id @default(uuid())
  projectId                 String
  project                   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  firstName                 String
  lastName                  String
  email                     String
  country                   String
  magicLinkToken            String                  @unique
  magicLinkActive           Boolean                 @default(true)
  status                    ParticipantStatus       @default(DRAFT)
  bankAccountIban           String?
  bankAccountHolderName     String?
  bankAccountBic            String?
  bankName                  String?
  personalAddress           String?
  personalCity              String?
  personalPostalCode        String?
  personalCountry           String?
  notesInternal             String?
  participantNote           String?                 // Note from participant explaining travel situations (e.g., missed bus, lost ticket)
  lastMagicLinkSentAt       DateTime?
  journeyConsolidatedAt     DateTime?               // When the AI last consolidated all documents
  detectedHomeCountry       String?                 // AI-detected home country based on travel patterns
  homeCountryConfidence     Float?                  // Confidence score (0-1) for detected home country
  homeCountryReasoning      String?                 // AI reasoning for the detected home country
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  documents                 Document[]
  travelItems               TravelItem[]
  travelBookings            TravelBooking[]
  reimbursementSummary      ReimbursementSummary?
  changeLogEntries          ChangeLogEntry[]
  declarationsOnHonor       DeclarationOnHonor[]
  createdDisseminations     DisseminationActivity[] @relation("CreatedActivities")
  socialMediaPosts          SocialMediaPost[]
  declarationsOfTravel      DeclarationOfTravel[]
  aiReviewFindings          AiReviewFinding[]
}

enum ParticipantStatus {
  DRAFT
  PARTICIPANT_COMPLETE
  ADMIN_APPROVED
  PAID
}

// Document - uploaded travel document
model Document {
  id               String              @id @default(uuid())
  participantId    String
  participant      Participant         @relation(fields: [participantId], references: [id], onDelete: Cascade)
  storedFilePath   String
  originalFilename String
  renamedFilename  String
  mimeType         String
  fileSize         Int
  uploadDate       DateTime            @default(now())
  documentType     DocumentType        @default(OTHER)
  ocrText          String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  travelItems      TravelItem[]
  extraction       DocumentExtraction?
}

// DocumentExtraction - raw AI-extracted data from a document (before consolidation)
model DocumentExtraction {
  id                    String       @id @default(uuid())
  documentId            String       @unique
  document              Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // What the AI thinks this document is
  detectedDocumentType  DocumentType
  confidence            Float        @default(0)

  // Extracted fields (all optional - AI extracts what it can find)
  passengerName         String?
  fromLocation          String?
  toLocation            String?

  // Different date types - the AI should identify which is which
  departureDate         DateTime?    // The actual travel date
  purchaseDate          DateTime?    // When the ticket was bought
  documentDate          DateTime?    // Date printed on document (could be either)

  // Flight-specific
  flightNumber          String?
  airline               String?
  bookingReference      String?
  seatNumber            String?

  // Train/Bus specific
  trainNumber           String?
  busCompany            String?

  // Bank transaction / payment specific
  merchantName          String?      // Merchant name from bank transactions (e.g., "PLESO PRIJEVOZ", "WIZZAIR")

  // Pricing
  amount                Float?
  currency              String?

  // Round-trip and multi-passenger detection
  isRoundTrip           Boolean  @default(false)  // Whether this booking covers both outbound and return
  numberOfPassengers    Int?                      // Number of passengers on the booking
  allPassengerNames     String?                   // Comma-separated list of passenger names
  outboundFlightNumber  String?                   // For round-trips: outbound flight number
  returnFlightNumber    String?                   // For round-trips: return flight number

  // Multi-ticket support (for documents containing multiple journey segments)
  additionalTickets     String?      // JSON array of additional tickets found in this document

  // AI reasoning for debugging
  extractionReasoning   String?      // Brief explanation of how the AI extracted data
  rawAiResponse         String?

  // Processing status
  consolidated          Boolean      @default(false)
  consolidatedAt        DateTime?

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

enum DocumentType {
  FLIGHT_INVOICE
  FLIGHT_BOARDING_PASS
  TRAIN_TICKET
  BUS_TICKET
  FUEL_RECEIPT
  GREEN_TRAVEL_DECLARATION
  HOTEL_INVOICE
  BANK_TRANSACTION
  OTHER
}

// TravelBooking - represents a booking that may contain multiple travel legs (e.g., round-trip flights)
model TravelBooking {
  id                    String                @id @default(uuid())
  participantId         String
  participant           Participant           @relation(fields: [participantId], references: [id], onDelete: Cascade)
  bookingReference      String?
  isRoundTrip           Boolean               @default(false)
  totalAmount           Float?                // Total booking price (may be null if unknown)
  currency              String                @default("EUR")
  totalAmountEur        Float?                // Converted to EUR
  numberOfPassengers    Int?                  // If booking covers multiple passengers
  documentIds           String?               // JSON array of document IDs that evidence this booking

  // Price editability
  hasPerLegPrices       Boolean               @default(false)  // True if per-leg prices were found in documents
  priceSource           String?               // Description of where the price came from (e.g., "Itinerary doc #3")

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  travelItems           TravelItem[]          // The individual legs in this booking
}

// TravelItem - a travel segment extracted from documents
model TravelItem {
  id                    String                @id @default(uuid())
  participantId         String
  participant           Participant           @relation(fields: [participantId], references: [id], onDelete: Cascade)
  documentId            String?
  document              Document?             @relation(fields: [documentId], references: [id], onDelete: SetNull)
  additionalDocumentIds String?               // JSON array of additional document IDs linked to this travel item

  // Link to booking (for round-trips and multi-leg journeys)
  bookingId             String?
  booking               TravelBooking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  modeOfTransport       TransportMode
  fromLocation          String
  toLocation            String
  departureDate         DateTime
  arrivalDate           DateTime?
  bookingReference      String?
  flightNumber          String?
  amountOriginal        Float?                // Nullable: null if price unknown or part of booking
  currencyOriginal      String                @default("EUR")
  purchaseDate          DateTime?
  amountEur             Float?                // Nullable: null if price unknown or part of booking
  comment               String?
  manuallyEdited        Boolean               @default(false)  // Track if participant edited AI values
  checked               Boolean               @default(false)  // User confirmed this travel item is correct
  originalAmountFromAi  Float?                // Store original AI-detected amount for comparison

  // Price editability for this leg
  priceEditable             Boolean               @default(true)   // False if part of booking with only total price
  priceMissing              Boolean               @default(false)  // True if no price found in any document
  priceSourceDocId          String?               // Document ID where this price was found
  amountIncludedInRoundTrip Boolean               @default(false)  // True if this is return leg with price on outbound

  // Legacy round-trip fields (kept for compatibility, prefer using TravelBooking)
  isRoundTrip           Boolean               @default(false)
  tripGroupId           String?
  priceAllocation       Float                 @default(1.0)
  totalGroupPrice       Float?

  // Multi-passenger bookings
  numberOfPassengers    Int?                  // If this booking was for multiple people
  participantPortion    Float?                // The portion this participant claims (entered by them)

  // Car travel specific
  distanceKm            Float?                // Distance traveled in kilometers
  isDriverCarpool       Boolean               @default(false)  // Whether this participant is the driver

  // Validation flags
  routeMatchesCountry   Boolean?              // Whether from/to matches participant's country
  validationWarnings    String?               // JSON array of warning messages

  // Exclusion from reimbursement
  excludedFromReimbursement Boolean           @default(false)  // User marked this item to be excluded from reimbursement (e.g., personal trip)

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  declarationsOfTravel  DeclarationOfTravel[]
}

enum TransportMode {
  PLANE
  TRAIN
  BUS
  CAR
  FERRY
  OTHER
}

// ReimbursementSummary - calculated totals for a participant
model ReimbursementSummary {
  id                          String      @id @default(uuid())
  participantId               String      @unique
  participant                 Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  totalOriginalCurrency       Float?
  totalEur                    Float       @default(0)
  maxReimbursementAllowed     Float       @default(0)
  amountToReimburse           Float       @default(0)
  adminNotes                  String?
  aiCheckOk                   Boolean     @default(false)
  adminApproved               Boolean     @default(false)
  paid                        Boolean     @default(false)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
}

// ChangeLogEntry - audit log for changes
model ChangeLogEntry {
  id            String      @id @default(uuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  userType      UserType
  fieldName     String
  previousValue String?
  newValue      String?
  changedAt     DateTime    @default(now())
}

enum UserType {
  PARTICIPANT
  ADMIN
}

// AI Review Finding - generated once when participant submits, checkable by org
model AiReviewFinding {
  id            String      @id @default(uuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  severity      String      // 'critical' | 'important' | 'info'
  message       String
  category      String
  checked       Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

// DeclarationOnHonor - for missing documents
model DeclarationOnHonor {
  id                  String      @id @default(uuid())
  participantId       String
  participant         Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  missingDocumentType DocumentType
  description         String
  reason              String
  place               String
  declarationDate     DateTime    @default(now())
  createdAt           DateTime    @default(now())
}

// ExchangeRate - cached InforEuro exchange rates
model ExchangeRate {
  id            String   @id @default(uuid())
  currencyCode  String   // e.g., "PLN", "CZK", "HUF"
  year          Int      // Year of the rate
  month         Int      // Month of the rate (1-12)
  rateToEur     Float    // Rate: 1 unit of currency = X EUR
  fetchedAt     DateTime @default(now())

  @@unique([currencyCode, year, month])
  @@index([currencyCode])
}

// Dissemination Activity - shared per country
model DisseminationActivity {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  country       String   // Country this activity belongs to
  title         String
  description   String
  activityDate  DateTime?
  createdById   String   // Participant who created this
  createdBy     Participant @relation("CreatedActivities", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  photos        DisseminationPhoto[]

  @@index([projectId, country])
}

// Dissemination Photo
model DisseminationPhoto {
  id                      String                @id @default(uuid())
  disseminationActivityId String
  disseminationActivity   DisseminationActivity @relation(fields: [disseminationActivityId], references: [id], onDelete: Cascade)
  storedFilePath          String
  originalFilename        String
  mimeType                String
  fileSize                Int
  uploadedAt              DateTime              @default(now())
}

// Social Media Post Screenshot - individual per participant
model SocialMediaPost {
  id               String      @id @default(uuid())
  participantId    String
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  storedFilePath   String
  originalFilename String
  mimeType         String
  fileSize         Int
  description      String?
  uploadedAt       DateTime    @default(now())
}

// Declaration of Travel - for missing boarding passes with signature
model DeclarationOfTravel {
  id                      String      @id @default(uuid())
  participantId           String
  participant             Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  travelItemId            String?
  travelItem              TravelItem? @relation(fields: [travelItemId], references: [id], onDelete: SetNull)

  // Travel details
  name                    String
  modeOfTransport         TransportMode
  fromPlace               String
  toPlace                 String
  travelDate              DateTime
  flightNumber            String?
  bookingReference        String?

  // Personal details
  dateOfBirth             DateTime
  idNumber                String

  // Sending organisation
  sendingOrgName          String
  sendingOrgOid           String?
  sendingOrgAddress       String

  // Signature
  signatureDataUrl        String      // Base64 encoded signature image
  signedAt                DateTime    @default(now())

  // Generated PDF
  generatedPdfPath        String?

  createdAt               DateTime    @default(now())
}
